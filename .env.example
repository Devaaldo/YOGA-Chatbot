# YOGA Chatbot — environment configuration
# Copy this file to `.env` and fill in the values:  cp .env.example .env

# --- Required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN= 

# --- Optional: NLU thresholds (defaults shown) ---
# Min predict_proba for the binary greeting detector to treat text as a greeting
GREETING_CONFIDENCE_THRESHOLD=0.7
# Texts with more tokens than this skip the greeting detector
WORD_COUNT_THRESHOLD=3
# Min predict_proba for the main classifier to commit to a label (else "fallback")
INTENT_CONFIDENCE_THRESHOLD=0.15

# --- Optional: logging ---
LOG_LEVEL=INFO
